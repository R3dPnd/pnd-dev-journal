    "terminal.ansiCyan": "#2ff3e0",
    "terminal.ansiBrightCyan": "#2ff3e0",
    "terminal.ansiGreen": "#28b485",
    "terminal.ansiBrightGreen": "#28b485",
    "terminal.ansiRed": "#f51720",
    "terminal.ansiBrightRed": "#f51720",
    "terminal.ansiYellow": "#f8d210",
    "terminal.ansiBrightYellow": "#f8d210",
    "terminal.ansiMagenta": "#4c175a",
